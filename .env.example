# Copy to .env and edit if needed. Every value is optional (defaults shown).

# Comma-separated list of allowed frontend origins.
# (Streamlit calls the API from its Python server, so CORS only matters for browser-based frontends.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501

# SQLite database file (default: backend/voiceguard.db)
# DATABASE_URL=sqlite:///./voiceguard.db

# Max upload size in MB (default 25)
# MAX_UPLOAD_MB=25

# Folder for TEMPORARY audio files (deleted right after analysis)
# UPLOAD_DIR=uploads
